# App + Airflow use the same MySQL (cfr_platform). Set this so the app shows all ingested CFR data.
# Docker: docker-compose already sets DATABASE_URL=mysql://app:app@mysql:3306/cfr_platform
# Local dev (pnpm dev): use 127.0.0.1 when MySQL runs in Docker (port 3306 exposed)
DATABASE_URL=mysql://app:app@127.0.0.1:3306/cfr_platform

# Redis cache configuration (optional - cache disabled if not set)
# Docker: redis password is set in docker-compose.yml (default: "redis")
# Local dev: use redis://127.0.0.1:6379 or set REDIS_PASSWORD if using password auth
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_PASSWORD=redis

# Optional: for Airflow (Linux/Mac)
# AIRFLOW_UID=50000
